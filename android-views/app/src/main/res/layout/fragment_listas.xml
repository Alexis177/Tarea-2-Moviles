<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pestañas y colecciones" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TabLayout y ViewPager2 permiten cambiar de página al pulsar o deslizar. Cada pestaña demuestra una forma de organizar elementos." />
  <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabMode="fixed" />
  <androidx.viewpager2.widget.ViewPager2 android:id="@+id/paginas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Catálogo interactivo de UI" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Versión Android con Views, XML y Fragments. Explora cada componente y prueba sus acciones." />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Entrada de texto" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Botones y acciones" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Selección" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4. Listas y colecciones" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5. Información y retroalimentación" android:layout_marginTop="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/abrir_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6. Contenedores y estructura" android:layout_marginTop="12dp" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
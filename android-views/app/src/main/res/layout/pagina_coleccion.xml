<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/descripcion_coleccion" android:padding="12dp" />
  <LinearLayout android:id="@+id/acciones_lista" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton android:id="@+id/vaciar_lista" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vaciar" />
    <com.google.android.material.button.MaterialButton android:id="@+id/restaurar_lista" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Restaurar" />
  </LinearLayout>
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/refrescar" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/coleccion" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="8dp" />
  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>